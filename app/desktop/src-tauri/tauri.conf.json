{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Columbus",
  "version": "0.7.0",
  "identifier": "org.columbus-gis.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Columbus",
        "width": 560,
        "height": 520,
        "minWidth": 420,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "The Columbus GIS companion window",
    "longDescription": "Shows each Columbus session running on this computer: its layers on a map, its tables, and the approvals waiting for you.",
    "macOS": { "minimumSystemVersion": "13.0" }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["columbus"] }
    }
  }
}
