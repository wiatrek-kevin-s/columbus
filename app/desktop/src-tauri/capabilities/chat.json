{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "chat",
  "description": "The chat window: its own chat, settings and map only. It can set or clear the API key but never read it.",
  "windows": ["chat"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-chat-settings",
    "allow-chat-save-settings",
    "allow-chat-set-key",
    "allow-chat-clear-key",
    "allow-chat-start",
    "allow-chat-send",
    "allow-chat-stop",
    "allow-chat-answer",
    "allow-chat-end",
    "allow-chat-open-map"
  ]
}
