{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: the app's own chat, connections, tools, the organization's switches and the read-only views (audit log, notes, pack, approvals inbox). Local pages only: no capability here names a remote origin, so the session page shown in the window's sandboxed frame (http://127.0.0.1) gets no access to the app. Widening changes (a connection, a switch turned on, a tool installed) are confirmed by the person in the app's own code (Touch ID, the account password or Windows Hello), not here; text from the AI, data, files and sessions is shown as text, never markup; a strict CSP allows no remote script. The API key can be set or cleared but never read. Approvals from other AI apps are only listed: the person decides on the browser page the session opens. See docs/reference.md, 'Companion window and desktop app'.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-sessions",
